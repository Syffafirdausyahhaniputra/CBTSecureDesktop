<Window x:Class="CBTSecureDesktop.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CBT Polinema - Dashboard"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PolinemaLightGray}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header dengan Polinema Branding -->
        <Border Grid.Row="0" 
               Background="{StaticResource PolinemaHeaderGradient}"
               Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="3" Opacity="0.3" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon placeholder removed for logo constraints -->

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SISTEM CBT POLINEMA"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="{StaticResource PolinemaWhite}"/>
                    <TextBlock Text="Dashboard Mahasiswa"
                              FontSize="16"
                              Foreground="{StaticResource PolinemaYellow}"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <!-- User Info -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <Border Background="{StaticResource PolinemaWhite}"
                           CornerRadius="25"
                           Padding="20,10"
                           Margin="0,0,15,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="0" Opacity="0.2" BlurRadius="8"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" 
                                      FontSize="18"
                                      Margin="0,0,10,0"/>
                            <TextBlock x:Name="StudentNameText"
                                      Text="Mahasiswa"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource PolinemaBluePrimary}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Keluar"
                           Style="{StaticResource PolinemaButtonSecondary}"
                           Height="40"
                           Padding="20,0"
                           Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     Padding="40,30">
            <StackPanel>
                <!-- Welcome Section -->
                <Border Background="{StaticResource PolinemaWhite}"
                       CornerRadius="12"
                       Padding="30"
                       Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="0" Opacity="0.08" BlurRadius="15"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Selamat Datang! 👋"
                                      FontSize="26"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource PolinemaBluePrimary}"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Silakan pilih ujian yang akan Anda kerjakan"
                                      FontSize="15"
                                      Foreground="{StaticResource PolinemaTextGray}"/>
                        </StackPanel>
                        
                        <Border Grid.Column="1"
                               Background="{StaticResource PolinemaLightGray}"
                               CornerRadius="50"
                               Width="80"
                               Height="80"
                               VerticalAlignment="Center">
                            <TextBlock Text="📚"
                                      FontSize="40"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Section Title and Refresh -->
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Daftar Ujian"
                              FontSize="22"
                              FontWeight="Bold"
                              Foreground="{StaticResource PolinemaBluePrimary}"
                              VerticalAlignment="Center"/>

                    <Button x:Name="RefreshButton"
                            HorizontalAlignment="Right"
                            Content="🔄 Refresh"
                            Style="{StaticResource PolinemaButtonSecondary}"
                            Padding="15,8"
                            FontSize="13"
                            Click="RefreshButton_Click"/>
                </Grid>

                <!-- Loading Indicator -->
                <StackPanel x:Name="LoadingPanel" 
                           HorizontalAlignment="Center"
                           Margin="0,50,0,0">
                    <ProgressBar IsIndeterminate="True"
                                Height="4"
                                Width="200"
                                Foreground="{StaticResource PolinemaGreen}"
                                Background="{StaticResource PolinemaBorderGray}"/>
                    <TextBlock Text="Memuat daftar ujian..."
                              FontSize="14"
                              Foreground="{StaticResource PolinemaTextGray}"
                              HorizontalAlignment="Center"
                              Margin="0,15,0,0"/>
                </StackPanel>

                <!-- Exams List -->
                <ItemsControl x:Name="ExamsListView" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PolinemaWhite}"
                                   BorderBrush="{StaticResource PolinemaBorderGray}"
                                   BorderThickness="2"
                                   CornerRadius="12"
                                   Padding="25"
                                   Margin="0,0,0,20">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" 
                                                     Direction="270" 
                                                     ShadowDepth="0" 
                                                     Opacity="0.08" 
                                                     BlurRadius="15"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                           Background="{StaticResource PolinemaLightGray}"
                                           CornerRadius="12"
                                           Width="60"
                                           Height="60"
                                           Margin="0,0,20,0">
                                        <TextBlock Text="📝"
                                                  FontSize="30"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Exam Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NamaUjian}" 
                                                  FontSize="20" 
                                                  FontWeight="Bold"
                                                  Foreground="{StaticResource PolinemaBluePrimary}"
                                                  Margin="0,0,0,8"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="📚" FontSize="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="Mata Kuliah: "
                                                      FontSize="14"
                                                      Foreground="{StaticResource PolinemaTextGray}"/>
                                            <TextBlock Text="{Binding Matakuliah.Nama}" 
                                                      FontSize="14"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource PolinemaDarkGray}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="🔖" FontSize="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="Kode: "
                                                      FontSize="14"
                                                      Foreground="{StaticResource PolinemaTextGray}"/>
                                            <TextBlock Text="{Binding KodeUjian}" 
                                                      FontSize="14"
                                                      FontWeight="SemiBold"
                                                      Foreground="{StaticResource PolinemaDarkGray}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⏱️" FontSize="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="Status: "
                                                      FontSize="14"
                                                      Foreground="{StaticResource PolinemaTextGray}"/>

                                            <!-- Dynamic state based on IsFinished -->
                                            <ContentControl Content="{Binding}">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Border Background="{StaticResource PolinemaGreen}"
                                                                           CornerRadius="10"
                                                                           Padding="8,3">
                                                                        <TextBlock Text="{Binding Status}" 
                                                                                  FontSize="12"
                                                                                  FontWeight="Bold"
                                                                                  Foreground="{StaticResource PolinemaWhite}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <Border Background="{StaticResource PolinemaTextGray}"
                                                                                   CornerRadius="10"
                                                                                   Padding="8,3">
                                                                                <TextBlock Text="Selesai" 
                                                                                          FontSize="12"
                                                                                          FontWeight="Bold"
                                                                                          Foreground="{StaticResource PolinemaWhite}"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Button / Score Display -->
                                    <ContentControl Content="{Binding}" Grid.Column="2" VerticalAlignment="Center">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Button Content="MULAI UJIAN"
                                                                   Style="{StaticResource PolinemaButtonPrimary}"
                                                                   Padding="25,15"
                                                                   FontSize="15"
                                                                   Tag="{Binding UjianId}"
                                                                   Click="StartExamButton_Click"/>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Border Background="{StaticResource PolinemaLightGray}" 
                                                                            BorderBrush="{StaticResource PolinemaGreen}" 
                                                                            BorderThickness="2" 
                                                                            CornerRadius="10" 
                                                                            Padding="15,10">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="Nilai: " FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PolinemaDarkGray}" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding SkorAkhir}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PolinemaGreen}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Security Warning -->
                <Border Background="#FFF3CD"
                       BorderBrush="#FFE69C"
                       BorderThickness="2"
                       CornerRadius="12"
                       Padding="25"
                       Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="⚠️"
                                      FontSize="24"
                                      Margin="0,0,10,0"/>
                            <TextBlock Text="INFORMASI KEAMANAN PENTING"
                                      FontWeight="Bold"
                                      FontSize="16"
                                      Foreground="#856404"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock TextWrapping="Wrap"
                                  FontSize="14"
                                  Foreground="#856404"
                                  LineHeight="24">
                            <Run Text="Ketika Anda memulai ujian:" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="• Aplikasi akan masuk ke mode layar penuh (fullscreen)"/>
                            <LineBreak/>
                            <Run Text="• Tombol Alt+Tab dan shortcut sistem lainnya akan dinonaktifkan"/>
                            <LineBreak/>
                            <Run Text="• Taskbar Windows akan disembunyikan"/>
                            <LineBreak/>
                            <Run Text="• Anda tidak dapat beralih ke aplikasi lain"/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="✓ Pastikan koneksi database stabil" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="✓ Jawaban akan otomatis tersimpan ke database" FontWeight="Bold"/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Anda hanya dapat keluar setelah menyelesaikan dan mengirim ujian." 
                                 FontWeight="Bold"
                                 FontSize="15"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
               Background="{StaticResource PolinemaWhite}"
               BorderBrush="{StaticResource PolinemaBorderGray}"
               BorderThickness="0,1,0,0"
               Padding="25,15">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center">
                    <TextBlock Text="© 2024 Politeknik Negeri Malang"
                              FontSize="12"
                              Foreground="{StaticResource PolinemaTextGray}"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <TextBlock Text="🔒 Mode Aman"
                              FontSize="12"
                              Foreground="{StaticResource PolinemaGreen}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"/>
                    <TextBlock Text="•"
                              FontSize="12"
                              Foreground="{StaticResource PolinemaBorderGray}"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"/>
                    <TextBlock Text="💾 Database Terhubung"
                              FontSize="12"
                              Foreground="{StaticResource PolinemaGreen}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
