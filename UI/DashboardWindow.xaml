<Window x:Class="CBTSecureDesktop.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CBT Polinema - Dashboard"
        Icon="/Assets/Images/CbtIcon.ico"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PolinemaLightGray}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header dengan Polinema Branding -->
        <Border Grid.Row="0" 
               Background="{StaticResource PolinemaHeaderGradient}"
               Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="3" Opacity="0.3" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon placeholder removed for logo constraints -->

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SISTEM CBT POLINEMA"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="{StaticResource PolinemaWhite}"/>
                    <TextBlock Text="Dashboard Mahasiswa"
                              FontSize="16"
                              Foreground="{StaticResource PolinemaYellow}"
                              Margin="0,5,0,0"/>
                </StackPanel>

                <!-- User Info with dropdown actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <ToggleButton x:Name="UserToggleButton" 
                  Width="220" 
                  Height="50" 
                  Cursor="Hand"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">

                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{StaticResource PolinemaWhite}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PolinemaBorderGray}"/>
                                <Setter Property="BorderThickness" Value="1"/>

                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Style.Resources>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F2F4F7"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PolinemaBluePrimary}"/>
                                    </Trigger>

                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#E4E7EC"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PolinemaBluePrimary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>

                        <Grid Width="190" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource PolinemaBluePrimary}" Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1" x:Name="StudentNameText" Text="Mahasiswa" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PolinemaBluePrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource PolinemaTextGray}"/>
                        </Grid>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=UserToggleButton}" PlacementTarget="{Binding ElementName=UserToggleButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                        <Border Background="{StaticResource PolinemaWhite}" CornerRadius="8" BorderBrush="{StaticResource PolinemaBorderGray}" BorderThickness="1" Width="220" Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="3" Opacity="0.15" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button Style="{StaticResource PolinemaButtonSecondary}" Margin="0,0,0,4" Padding="12,8" HorizontalContentAlignment="Left" Click="ChangePasswordButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE104;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource PolinemaBluePrimary}"/>
                                        <TextBlock Text="Ubah Password" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PolinemaButtonDanger}" Padding="12,8" HorizontalContentAlignment="Left" Click="LogoutButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Keluar" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     Padding="40,30">
            <StackPanel>
                <!-- Welcome Section -->
                <Border Background="{StaticResource PolinemaWhite}"
                       CornerRadius="12"
                       Padding="30"
                       Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="0" Opacity="0.08" BlurRadius="15"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Selamat Datang! 👋"
                                      FontSize="26"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource PolinemaBluePrimary}"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Silakan pilih ujian yang akan Anda kerjakan"
                                      FontSize="15"
                                      Foreground="{StaticResource PolinemaTextGray}"/>
                        </StackPanel>
                        
                        <Border Grid.Column="1"
                               Background="{StaticResource PolinemaLightGray}"
                               CornerRadius="50"
                               Width="80"
                               Height="80"
                               VerticalAlignment="Center">
                            <TextBlock Text="📚"
                                      FontSize="40"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Section Title and Refresh -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Daftar Ujian"
                              FontSize="22"
                              FontWeight="Bold"
                              Foreground="{StaticResource PolinemaBluePrimary}"
                              VerticalAlignment="Center"/>

                    <Button x:Name="RefreshButton"
                            HorizontalAlignment="Right"
                            Content="🔄 Refresh"
                            Style="{StaticResource PolinemaButtonSecondary}"
                            Padding="15,8"
                            FontSize="13"
                            Click="RefreshButton_Click"/>
                </Grid>

                <TextBlock x:Name="PreparationStatusText"
                          Text=""
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource PolinemaTextGray}"
                          Margin="0,0,0,20"
                          Visibility="Collapsed"
                          TextWrapping="Wrap"/>

                <!-- Loading Indicator -->
                <StackPanel x:Name="LoadingPanel" 
                           HorizontalAlignment="Center"
                           Margin="0,50,0,0">
                    <ProgressBar IsIndeterminate="True"
                                Height="4"
                                Width="200"
                                Foreground="{StaticResource PolinemaGreen}"
                                Background="{StaticResource PolinemaBorderGray}"/>
                    <TextBlock Text="Memuat daftar ujian..."
                              FontSize="14"
                              Foreground="{StaticResource PolinemaTextGray}"
                              HorizontalAlignment="Center"
                              Margin="0,15,0,0"/>
                </StackPanel>

                <!-- Sections are reordered. Note ExamsList is shown concurrently with progress. -->
                <!-- Download Progress Indicator -->
                <Border x:Name="DownloadPanel" 
                        Visibility="Collapsed"
                        Background="{StaticResource PolinemaWhite}"
                        BorderBrush="{StaticResource PolinemaBorderGray}"
                        BorderThickness="2"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar x:Name="DownloadProgressBar"
                                    Minimum="0" Maximum="100" Value="0"
                                    Height="8"
                                    Width="300"
                                    Foreground="{StaticResource PolinemaBluePrimary}"
                                    Background="{StaticResource PolinemaBorderGray}"/>
                        <TextBlock x:Name="DownloadProgressText"
                                  Text="Mengunduh gambar 0 dari 0..."
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource PolinemaTextGray}"
                                  HorizontalAlignment="Center"
                                  Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Exams List -->
                <Border x:Name="ExamsListContainer"
                        Background="{StaticResource PolinemaLightGray}"
                        CornerRadius="12"
                        Padding="8"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <ListBox x:Name="ExamsListView"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="360"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
         
                             ScrollViewer.PanningMode="VerticalOnly"
         
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLengthUnit="Item"
                             VirtualizingPanel.CacheLength="2,2">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="InnerBorder"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="InnerBorder" Property="Background" Value="Transparent"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="InnerBorder" Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PolinemaWhite}"
                                        BorderBrush="{StaticResource PolinemaBorderGray}"
                                        BorderThickness="2"
                                        CornerRadius="12"
                                        Padding="25"
                                        Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000"
                                                          Direction="270"
                                                          ShadowDepth="0"
                                                          Opacity="0.08"
                                                          BlurRadius="15"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Border Grid.Column="0"
                                                Background="{StaticResource PolinemaLightGray}"
                                                CornerRadius="12"
                                                Width="60"
                                                Height="60"
                                                Margin="0,0,20,0">
                                            <TextBlock Text="📝"
                                                       FontSize="30"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Exam Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NamaUjian}"
                                                      FontSize="20"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource PolinemaBluePrimary}"
                                                      Margin="0,0,0,8"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="📚" FontSize="14" Margin="0,0,5,0"/>
                                                <TextBlock Text="Mata Kuliah: "
                                                          FontSize="14"
                                                          Foreground="{StaticResource PolinemaTextGray}"/>
                                                <TextBlock Text="{Binding Matakuliah.Nama}"
                                                          FontSize="14"
                                                          FontWeight="SemiBold"
                                                          Foreground="{StaticResource PolinemaDarkGray}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="🔖" FontSize="14" Margin="0,0,5,0"/>
                                                <TextBlock Text="Kode: "
                                                          FontSize="14"
                                                          Foreground="{StaticResource PolinemaTextGray}"/>
                                                <TextBlock Text="{Binding KodeUjian}"
                                                          FontSize="14"
                                                          FontWeight="SemiBold"
                                                          Foreground="{StaticResource PolinemaDarkGray}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⏱️" FontSize="14" Margin="0,0,5,0"/>
                                                <TextBlock Text="Status: "
                                                          FontSize="14"
                                                          Foreground="{StaticResource PolinemaTextGray}"/>

                                                <Border Background="{StaticResource PolinemaGreen}"
                                                       CornerRadius="10"
                                                       Padding="8,3"
                                                       Margin="0,0,15,0">
                                                    <TextBlock Text="{Binding DisplayStatus}"
                                                              FontSize="12"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource PolinemaWhite}"/>
                                                </Border>

                                                <TextBlock Text="{Binding NilaiText}"
                                                          FontSize="16"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource PolinemaYellow}"
                                                          Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Button / Score Display -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Content="Persiapan Ujian"
                                                    Visibility="{Binding PersiapanVisibility}"
                                                    Style="{StaticResource PolinemaButtonSecondary}"
                                                    Padding="15,15"
                                                    FontSize="15"
                                                    Margin="0,0,10,0"
                                                    Click="PersiapanButton_Click"/>
                                            <Button Content="{Binding ActionText}"
                                                    Visibility="{Binding ActionVisibility}"
                                                    IsEnabled="{Binding IsActionEnabled}"
                                                    Style="{StaticResource PolinemaButtonPrimary}"
                                                    Padding="25,15"
                                                    FontSize="15"
                                                    Click="StartExamButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Informasi Penting Ujian -->
                <Border Background="#EEF6FF"
                       BorderBrush="#BFDBFE"
                       BorderThickness="2"
                       CornerRadius="12"
                       Padding="25"
                       Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="ℹ️"
                                      FontSize="24"
                                      Margin="0,0,10,0"/>
                            <TextBlock Text="INFORMASI PENTING SEBELUM UJIAN"
                                      FontWeight="Bold"
                                      FontSize="16"
                                      Foreground="#1E40AF"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap"
                                  FontSize="14"
                                  Foreground="#1E3A8A"
                                  LineHeight="24">
                            <Run Text="Agar tombol ujian selalu terbarui:" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="• Tekan tombol Refresh saat mendekati jam mulai ujian."/>
                            <LineBreak/>
                            <Run Text="• Ujian yang belum Anda kerjakan akan ditampilkan di bagian atas."/>
                            <LineBreak/>
                            <Run Text="• Lakukan Persiapan Ujian terlebih dahulu agar gambar soal lebih siap saat ujian dimulai."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Saat ujian dimulai, aplikasi akan masuk mode aman:" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="• Layar penuh akan aktif dan perpindahan aplikasi dibatasi."/>
                            <LineBreak/>
                            <Run Text="• Jawaban tersimpan otomatis selama proses ujian."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Selesaikan ujian hingga submit agar sesi berakhir dengan benar."
                                 FontWeight="Bold"
                                 FontSize="15"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
               Background="{StaticResource PolinemaWhite}"
               BorderBrush="{StaticResource PolinemaBorderGray}"
               BorderThickness="0,1,0,0"
               Padding="25,15">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center">
                    <TextBlock Text="© 2026 Politeknik Negeri Malang"
                              FontSize="12"
                              Foreground="{StaticResource PolinemaTextGray}"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <TextBlock Text="🔒 Mode Aman"
                              FontSize="12"
                              Foreground="{StaticResource PolinemaGreen}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"/>
                    <TextBlock Text="•"
                              FontSize="12"
                              Foreground="{StaticResource PolinemaBorderGray}"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"/>
                    <TextBlock Text="💾 Database Terhubung"
                              FontSize="12"
                              Foreground="{StaticResource PolinemaGreen}"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
