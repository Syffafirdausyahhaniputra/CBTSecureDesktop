<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Polinema Primary Colors -->
    <SolidColorBrush x:Key="PolinemaBluePrimary" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="PolinemaBlueSecondary" Color="#1A3066"/>
    <SolidColorBrush x:Key="PolinemaYellow" Color="#FBBF24"/>
    <SolidColorBrush x:Key="PolinemaOrange" Color="#F5A623"/>
    <SolidColorBrush x:Key="PolinemaWhite" Color="#FFFFFF"/>
    
    <!-- Polinema Secondary Colors -->
    <SolidColorBrush x:Key="PolinemaDarkGray" Color="#333333"/>
    <SolidColorBrush x:Key="PolinemaGreen" Color="#22C55E"/>
    <SolidColorBrush x:Key="PolinemaGreenHover" Color="#16A34A"/>
    <SolidColorBrush x:Key="PolinemaBlack" Color="#000000"/>
    <SolidColorBrush x:Key="PolinemaBlueLink" Color="#007BFF"/>
    
    <!-- Additional Utility Colors -->
    <SolidColorBrush x:Key="PolinemaLightGray" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PolinemaBorderGray" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="PolinemaTextGray" Color="#666666"/>
    <SolidColorBrush x:Key="PolinemaRed" Color="#EF4444"/>
    
    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="PolinemaHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E3A8A" Offset="0"/>
        <GradientStop Color="#1A3066" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PolinemaAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FBBF24" Offset="0"/>
        <GradientStop Color="#F5A623" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Button Styles -->
    <Style x:Key="PolinemaButtonPrimary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PolinemaGreen}"/>
        <Setter Property="Foreground" Value="{StaticResource PolinemaWhite}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                           CornerRadius="6"
                           Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PolinemaGreenHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="PolinemaButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PolinemaYellow}"/>
        <Setter Property="Foreground" Value="{StaticResource PolinemaDarkGray}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                           CornerRadius="6"
                           Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PolinemaOrange}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- TextBox Style -->
    <Style x:Key="PolinemaTextBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource PolinemaBorderGray}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="{StaticResource PolinemaWhite}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           BorderThickness="{TemplateBinding BorderThickness}"
                           CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" 
                                     Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource PolinemaBluePrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- PasswordBox Style -->
    <Style x:Key="PolinemaPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource PolinemaBorderGray}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="{StaticResource PolinemaWhite}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           BorderThickness="{TemplateBinding BorderThickness}"
                           CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" 
                                     Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource PolinemaBluePrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>
