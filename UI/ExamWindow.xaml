<Window x:Class="CBTSecureDesktop.UI.ExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CBT Polinema - Mode Ujian" 
        WindowState="Normal"
        Background="{StaticResource PolinemaLightGray}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
               Background="{StaticResource PolinemaBluePrimary}"
               Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="3" Opacity="0.3" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo space removed per request -->

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="🔒 UJIAN SEDANG BERLANGSUNG"
                              FontSize="22"
                              FontWeight="Bold"
                              Foreground="{StaticResource PolinemaWhite}"/>
                    <TextBlock Text="Mode Aman Aktif - Jangan tutup aplikasi"
                              FontSize="13"
                              Foreground="{StaticResource PolinemaYellow}"
                              Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Timer & Question Counter -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <!-- Nav Toggle
                    <Button x:Name="ToggleNavButton"
                            Click="ToggleNavButton_Click"
                            Background="{StaticResource PolinemaWhite}"
                            BorderThickness="0"
                            Padding="15,10"
                            Margin="0,0,15,0"
                            Cursor="Hand" Width="110">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="0" Opacity="0.2" BlurRadius="8"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="18" Margin="5,8,0,0"/>
                                        <TextBlock Text="Daftar Soal" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PolinemaBluePrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    -->

                    <!-- Timer -->
                    <Border Background="{StaticResource PolinemaYellow}"
                           CornerRadius="10"
                           Padding="15,10"
                           Margin="0,0,15,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="0" Opacity="0.2" BlurRadius="8"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱️"
                                      FontSize="18"
                                      Margin="0,0,8,0"/>
                            <TextBlock x:Name="TimerText" 
                                      Text="00:00:00" 
                                      FontSize="18" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource PolinemaBluePrimary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Question Counter -->
                    <Border Background="{StaticResource PolinemaWhite}"
                           CornerRadius="10"
                           Padding="15,10">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="0" Opacity="0.2" BlurRadius="8"/>
                        </Border.Effect>
                        <TextBlock x:Name="QuestionCountText" 
                                  Text="Soal 1 dari 5" 
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource PolinemaBluePrimary}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Area with Navigation Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Question Area -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Question Number Badge -->
                        <Border Grid.Column="0" Background="{StaticResource PolinemaBluePrimary}"
                               CornerRadius="25"
                               Padding="20,10"
                               HorizontalAlignment="Left">
                            <TextBlock x:Name="QuestionNumberText" 
                                      Text="Pertanyaan 1" 
                                      FontSize="16" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource PolinemaWhite}"/>
                        </Border>

                        <!-- Refresh Button -->
                        <Button x:Name="RefreshExamButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Content="🔄 Refresh Soal"
                                Style="{StaticResource PolinemaButtonSecondary}"
                                Padding="15,8"
                                FontSize="13"
                                Click="RefreshExamButton_Click"/>
                    </Grid>

                    <!-- Question Text -->
                    <Border Background="{StaticResource PolinemaWhite}" 
                           BorderBrush="{StaticResource PolinemaBorderGray}" 
                           BorderThickness="2"
                           CornerRadius="12"
                           Padding="30"
                           Margin="0,0,0,30">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="0" Opacity="0.08" BlurRadius="15"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="QuestionText" 
                                      Text="Teks pertanyaan akan muncul di sini..." 
                                      FontSize="17"
                                      Foreground="{StaticResource PolinemaDarkGray}"
                                      TextWrapping="Wrap"
                                      LineHeight="28"
                                      Margin="0,0,0,15"/>
                            <Image x:Name="QuestionImage" Stretch="Uniform" MaxHeight="300" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,15"/>
                        </StackPanel>
                    </Border>

                    <!-- Answer Options Label -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="📝"
                                  FontSize="18"
                                  Margin="0,0,10,0"/>
                        <TextBlock Text="Pilih Jawaban Anda:" 
                                  FontSize="16" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource PolinemaBluePrimary}"/>
                    </StackPanel>

                    <!-- Answer Options -->
                    <StackPanel x:Name="OptionsPanel">
                        <!-- Options will be dynamically generated -->
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Navigation Panel -->
            <Border x:Name="NavPanel" Grid.Column="1" Width="300"
                    Background="{StaticResource PolinemaWhite}"
                    BorderBrush="{StaticResource PolinemaBorderGray}"
                    BorderThickness="1,0,0,0"
                    Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Navigasi Soal"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource PolinemaBluePrimary}"
                               Margin="20"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="QuestionNavPanel" Margin="15,0,15,20"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Navigation Footer -->
        <Border Grid.Row="2" 
               Background="{StaticResource PolinemaWhite}" 
               BorderBrush="{StaticResource PolinemaBorderGray}" 
               BorderThickness="0,2,0,0"
               Padding="40,25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Prev -->
                    <ColumnDefinition Width="Auto"/> <!-- Next -->
                    <ColumnDefinition Width="*"/>    <!-- Middle Section / Progress -->
                    <ColumnDefinition Width="Auto"/> <!-- Submit -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,15,0">
                    <!-- Previous Button -->
                    <Button x:Name="PreviousButton" 
                           Content="← SEBELUMNYA" 
                           Style="{StaticResource PolinemaButtonSecondary}"
                           Padding="25,12"
                           FontSize="14"
                           Margin="0,0,15,0"
                           Click="PreviousButton_Click"
                           Visibility="Visible"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0">
                    <!-- Next Button -->
                    <Button x:Name="NextButton" 
                           Content="SELANJUTNYA →" 
                           Style="{StaticResource PolinemaButtonSecondary}"
                           Padding="25,12"
                           FontSize="14"
                           Click="NextButton_Click"
                           Visibility="Visible"/>
                </StackPanel>

                <!-- Progress Info -->
                <Border Grid.Column="2"
                       Background="{StaticResource PolinemaLightGray}"
                       CornerRadius="20"
                       Padding="20,10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="📊"
                                  FontSize="16"
                                  Margin="0,0,10,0"/>
                        <TextBlock x:Name="ProgressText"
                                  Text="Progress: 1/5 Dijawab"
                                  FontSize="13"
                                  Foreground="{StaticResource PolinemaTextGray}"
                                  FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Submit Button -->
                <Button x:Name="SubmitButton" 
                       Grid.Column="3"
                       HorizontalAlignment="Right"
                       Content="✓ SELESAI &amp; KIRIM" 
                       Style="{StaticResource PolinemaButtonPrimary}"
                       Padding="25,12"
                       FontSize="14"
                       FontWeight="Bold"
                       Click="SubmitButton_Click">
                    <Button.Effect>
                        <DropShadowEffect Color="{Binding Source={StaticResource PolinemaGreen}, Path=Color}" 
                                         Direction="270" 
                                         ShadowDepth="0" 
                                         Opacity="0.4" 
                                         BlurRadius="15"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
