<Window x:Class="CBTSecureDesktop.UI.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ubah Password"
        Icon="/Assets/Images/CbtIcon.ico"
        Width="500"
        SizeToContent="Height" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PolinemaLightGray}">

    <Grid Margin="20">
        <Border Background="{StaticResource PolinemaWhite}"
                CornerRadius="12"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.08" BlurRadius="12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE104;" FontFamily="Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center" Foreground="{StaticResource PolinemaBluePrimary}" Margin="0,0,10,0"/>
                        <TextBlock Text="Ubah Password"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PolinemaBluePrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Masukkan password saat ini dan password baru untuk memperbarui keamanan akun Anda."
                               FontSize="13"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PolinemaTextGray}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Password Saat Ini"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PolinemaDarkGray}" Margin="0,0,0,6"/>
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource PolinemaPasswordBox}" Height="38" Padding="10,0,40,0" PasswordChanged="CurrentPasswordBox_PasswordChanged"/>
                        <TextBox x:Name="CurrentTextBox" Height="38" Padding="10,0,40,0" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="CurrentTextBox_TextChanged"/>
                        <ToggleButton x:Name="ToggleCurrentBtn" HorizontalAlignment="Right" Width="38" Height="38" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleCurrentBtn_Click">
                            <TextBlock x:Name="IconCurrent" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PolinemaTextGray}"/>
                        </ToggleButton>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Password Baru"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PolinemaDarkGray}" Margin="0,0,0,6"/>
                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource PolinemaPasswordBox}" Height="38" Padding="10,0,40,0" PasswordChanged="NewPasswordBox_PasswordChanged"/>
                        <TextBox x:Name="NewTextBox" Height="38" Padding="10,0,40,0" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="NewTextBox_TextChanged"/>
                        <ToggleButton x:Name="ToggleNewBtn" HorizontalAlignment="Right" Width="38" Height="38" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleNewBtn_Click">
                            <TextBlock x:Name="IconNew" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PolinemaTextGray}"/>
                        </ToggleButton>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="Konfirmasi Password Baru"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PolinemaDarkGray}" Margin="0,0,0,6"/>
                    <Grid Grid.Row="5">
                        <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource PolinemaPasswordBox}" Height="38" Padding="10,0,40,0" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                        <TextBox x:Name="ConfirmTextBox" Height="38" Padding="10,0,40,0" VerticalContentAlignment="Center" Visibility="Collapsed" TextChanged="ConfirmTextBox_TextChanged"/>
                        <ToggleButton x:Name="ToggleConfirmBtn" HorizontalAlignment="Right" Width="38" Height="38" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleConfirmBtn_Click">
                            <TextBlock x:Name="IconConfirm" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PolinemaTextGray}"/>
                        </ToggleButton>
                    </Grid>

                    <TextBlock Grid.Row="6" x:Name="ErrorText"
                               Visibility="Collapsed"
                               Margin="0,12,0,0"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{StaticResource PolinemaRed}"
                               TextWrapping="Wrap"/>
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="Batal"
                            Width="115"
                            Height="38"
                            Margin="0,0,12,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Padding="0" 
                            VerticalContentAlignment="Center"
                            Style="{StaticResource PolinemaButtonSecondary}"
                            Click="CancelButton_Click"/>

                    <Button x:Name="SaveButton"
                            Content="Simpan"
                            Width="115"
                            Height="38"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Padding="0" 
                            VerticalContentAlignment="Center"
                            Style="{StaticResource PolinemaButtonPrimary}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>